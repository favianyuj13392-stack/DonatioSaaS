# Root gitignore for Donatio SaaS

# Dependencies
node_modules/
vendor/

# Environment files
.env
.env.backup
.env.production
*.env

# Laravel specific
backend/storage/*.key
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/bootstrap/cache/*
backend/public/storage
backend/public/hot

# Frontend build & cache
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.tsbuildinfo

# Test artifacts & reports
test-results/
playwright-report/
blob-report/
playwright/.cache/
frontend/screenshots/donation_form_internacional.png
frontend/screenshots/donation_form_nacional.png
frontend/screenshots/

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
